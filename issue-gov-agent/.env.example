# ----- 修改env需要重启服务后生效 -----

# 服务接收端口
WEBHOOK_PORT=7000

# manage.py init 在服务根目录生成 .env 和随机 Webhook 密码；不要提交实际凭据。
WEBHOOK_SECRET=replace-with-a-random-secret
# 负责发布评论的服务账号的个人访问令牌：需读取接入仓库的代码和Issue，并创建评论。
ATOMGIT_TOKEN=replace-with-an-atomgit-access-token

# 统一模型配置，示例：LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic，LLM_MODEL=glm-5.3
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 多个模型密钥用英文逗号分隔。填写后每个密钥会在首次失败后再重试 LLM_KEY_RETRIES 次，
# 相邻两次间隔 LLM_KEY_RETRY_INTERVAL 秒，然后切换下一个密钥。全部失败时任务进入死信队列。
# 留空时仍只使用 LLM_API_KEY，manage.py 启动方式保持原来的任务级重试。
LLM_API_KEYS=
LLM_KEY_RETRIES=2
LLM_KEY_RETRY_INTERVAL=10

# 数据库路径相对于 issue-gov-agent/；需放在可写的本地磁盘。manage.py 使用该 SQLite 文件。
# WEBHOOK_DB=./runtime/data/events.sqlite3

# 容器使用的数据库和队列。全项目只使用这一份 .env，不要在仓库根目录再放一份。
# 口令只写在下面的口令项里，服务在 SERVICE_MODE=queue 时拼出连接串。
# 口令只能用字母和数字。init 会把口令占位符换成随机值。
# 主机名默认是 postgres 和 rabbitmq，只在 Compose 网络内可解析。容器内部端口是 5432 和 5672。
# manage.py 不设置 SERVICE_MODE，因此仍使用上面的 SQLite，不会解析这些主机名。
# 本机验证需要覆盖连接串时，可在进程环境中设置 DATABASE_URL 和 RABBITMQ_URL，不要写进本文件。
POSTGRES_USER=issue
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=issue_gov
POSTGRES_PORT=54329
RABBITMQ_USER=issue
RABBITMQ_PASSWORD=replace-with-a-queue-password
RABBITMQ_PORT=56729
RABBITMQ_MANAGEMENT_PORT=15672
