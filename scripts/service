#!/usr/bin/env bash
# 容器运维入口。环境文件是 issue-gov-agent/.env，不要在仓库根目录另建 .env。
#
#   scripts/service up [传给 compose up 的额外参数]
#   scripts/service status
#   scripts/service retry
#   scripts/service compose <docker compose 参数>
# 消费者副本数写在 docker-compose.yml 的 consumer.deploy.replicas，本脚本不再另记。
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT/issue-gov-agent/.env"
REPOSITORY_FILE="$ROOT/issue-gov-agent/repository.yml"

# 应用容器按执行本脚本的用户身份运行（见 docker-compose.yml 的 user:）。
# bash 的 UID 是只读变量，GID 默认未设置，所以用独立的 CONTAINER_UID/GID 传给 Compose；
# shell 里显式导出这两个值可以覆盖，例如 CONTAINER_UID=1001 scripts/service up。
CONTAINER_UID="${CONTAINER_UID:-$(id -u)}"
CONTAINER_GID="${CONTAINER_GID:-$(id -g)}"
export CONTAINER_UID CONTAINER_GID

usage() {
  echo "用法：scripts/service up|status|retry|compose <docker compose 参数>" >&2
  echo "消费者副本数写在 docker-compose.yml 的 consumer.deploy.replicas。" >&2
}

check_readable() {
  local uid="$1" file="$2"
  if [[ "$(id -u)" == "$uid" ]]; then
    [[ -r "$file" ]] && return 0
    echo "容器运行用户（uid=$uid）无法读取 $file。" >&2
    return 1
  fi
  # 不是同一用户时，只有 root 或 sudo 免密可用才能做真实读取检查；否则只提示。
  if [[ "$(id -u)" == "0" ]] || sudo -n true 2>/dev/null; then
    if sudo -n -u "#${uid}" test -r "$file" 2>/dev/null; then
      return 0
    fi
    echo "容器运行用户（uid=$uid）无法读取 $file。请执行：chown $uid \"$file\"" >&2
    return 1
  fi
  echo "提示：容器以 uid=$uid 运行。若启动报 Permission denied，请执行：chown $uid \"$file\"" >&2
  return 0
}

compose() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "未找到 docker，请先安装 Docker Engine 与 Compose 插件。" >&2
    exit 1
  fi
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "缺少 issue-gov-agent/.env。请先在 issue-gov-agent 目录执行 manage.py init。" >&2
    exit 1
  fi
  cd "$ROOT"
  docker compose --env-file "$ENV_FILE" "$@"
}

webhook_port() {
  local port
  port="$(grep -E '^WEBHOOK_PORT=' "$ENV_FILE" | tail -n 1 | cut -d= -f2- | tr -d '"' || true)"
  if [[ -z "$port" ]]; then
    port=7000
  fi
  printf '%s' "$port"
}

cmd="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  up)
    cd "$ROOT"
    if [[ ! -f issue-gov-agent/.env || ! -f issue-gov-agent/repository.yml ]]; then
      if [[ -x issue-gov-agent/.venv/bin/python ]]; then
        PYTHON=issue-gov-agent/.venv/bin/python
      else
        PYTHON=python3
      fi
      (cd issue-gov-agent && "$PYTHON" manage.py init)
      echo "已生成 issue-gov-agent/.env 和 repository.yml。"
      echo "请填写令牌、模型配置和接入仓库后重新执行 scripts/service up。"
      exit 1
    fi
    check_readable "$CONTAINER_UID" "$ENV_FILE" && check_readable "$CONTAINER_UID" "$REPOSITORY_FILE" || exit 1
    compose up -d --build "$@"
    echo "等待接收服务就绪..."
    PORT="$(webhook_port)"
    python3 - "$PORT" <<'PY'
import sys, time, urllib.request
port = sys.argv[1]
deadline = time.time() + 90
while time.time() < deadline:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/ready", timeout=3) as response:
            if response.status == 200:
                raise SystemExit(0)
    except Exception:
        time.sleep(2)
print("接收服务未在 90 秒内就绪。查看日志：scripts/service compose logs --tail=80 receiver", file=sys.stderr)
raise SystemExit(1)
PY
    compose ps
    echo "接收地址：http://127.0.0.1:${PORT}/webhook"
    echo "消费者副本数见 docker-compose.yml 的 consumer.deploy.replicas。"
    ;;
  status)
    compose ps
    echo
    PORT="$(webhook_port)"
    python3 - "$PORT" <<'PY'
import sys, urllib.request
port = sys.argv[1]
for path in ("/health", "/ready"):
    with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=3) as response:
        print(f"{path}：{response.read().decode()}")
PY
    ;;
  scale)
    echo "消费者副本数写在 docker-compose.yml 的 consumer.deploy.replicas。" >&2
    echo "灰度机器同时修改 /opt/CommunityGovAgent/docker-compose.yml，再在对应目录执行 docker compose up -d。" >&2
    exit 1
    ;;
  retry)
    compose exec -T consumer python -m issue_gov.worker --retry-failed
    ;;
  compose)
    if [[ $# -eq 0 ]]; then
      usage
      exit 1
    fi
    compose "$@"
    ;;
  *)
    usage
    exit 1
    ;;
esac
